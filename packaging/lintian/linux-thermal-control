# libicudata is an architecture-specific data container with no ELF DT_NEEDED entries.
linux-thermal-control: shared-library-lacks-prerequisites usr/lib/linux-thermal-control/lib/libicudata.so.73.2

# The package is assembled without debhelper; maintainer scripts must reload
# systemd after installing/removing a unit so fresh dpkg installs work.
linux-thermal-control: maintainer-script-calls-systemctl [postinst:*]
