[Unit]
Description=Linux thermal and fan control daemon
Documentation=man:linux-thermal-control(1)
Requires=dbus.socket
After=dbus.socket

[Service]
Type=dbus
BusName=org.linuxthermal.Control1
ExecStart=/usr/libexec/linux-thermal-control/linux-thermal-daemon
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
StateDirectory=linux-thermal-control
StateDirectoryMode=0750
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
# ProtectClock=yes prevents NVIDIA NVML initialization on some laptop drivers.
ProtectClock=no
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
Alias=dbus-org.linuxthermal.Control1.service
