# 开发镜像名称、版本与目标平台。
DOCKER_IMAGE_VERSION=ubuntu22.04-qt6.11.2
DOCKER_PLATFORM=linux/amd64
DOCKER_REPOSITORY=linux-thermal-control-dev

# 基础镜像来源及本地缓存名称。可将 UBUNTU_BASE_IMAGE 改为镜像站地址。
UBUNTU_BASE_IMAGE=ubuntu:22.04
LOCAL_BASE_IMAGE=linux-thermal-ubuntu22-base:local

# 容器内 APT 软件源。地址末尾不要添加路径分隔符。
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
UBUNTU_SECURITY_MIRROR=http://security.ubuntu.com/ubuntu

# 开发工具链及持久化构建缓存。
QT_VERSION=6.11.2
BUILD_CACHE_VOLUME=linux-thermal-control-build-cache
